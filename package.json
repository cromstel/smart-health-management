{
  "name": "smart-health-manager",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup": "bash setup.sh",
    "dev:all": "concurrently \"npm run dev\" \"cd server && npm run dev\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "verify": "npm run lint && npm run type-check && npm run test -- --run && npm run build",
    "secrets": "node scripts/generate-secrets.mjs"
