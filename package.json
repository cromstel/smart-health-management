  "overrides": {
    "eslint": {
      "ajv": {
        "json-schema-traverse": "0.4.1"
      }
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@google/genai@2.21.0": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "protobufjs@7.6.6": true
