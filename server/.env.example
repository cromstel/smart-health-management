# Smart Health Manager - JWT Security Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NAME=Smart Health Manager
PORT=5600
HTTPS_PORT=8443
NODE_ENV=development

# Frontend Configuration
VITE_API_URL=http://localhost:5600/api
VITE_BASE_URL=http://localhost:5174

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=webapp
DB_PASSWORD=webApp123!
DB_NAME=smart_health_manager
DB_DIALECT=mysql

# =============================================================================
# ENHANCED JWT SECURITY CONFIGURATION
# =============================================================================

# JWT Algorithm (HS256 for development, RS256 for production)
# HS256: Symmetric encryption (uses JWT_SECRET)
# RS256: Asymmetric encryption (uses RSA key pairs)
JWT_ALGORITHM=HS256

# HS256 Configuration (Development/Testing)
# Generate a secure secret: npm run jwt:generate-key
JWT_SECRET=dev-jwt-secret-key-for-development-only

# RS256 Configuration (Production)
# Generate RSA keys: npm run jwt:generate-rsa
# JWT_PRIVATE_KEY_PATH=./keys/private.pem
# JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_JWKS_ENDPOINT=/api/auth/jwks

# JWT Claims Configuration
JWT_ISSUER=smart-health-manager
JWT_AUDIENCE=healthcare-api

# Token Expiration (supports: s=seconds, m=minutes, h=hours, d=days)
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
JWT_SESSION_TOKEN_EXPIRES_IN=24h

# Security Features
JWT_ENABLE_BLACKLIST=true
JWT_ENCRYPT_PAYLOAD=false
JWT_VALIDATE_ISSUER=true
JWT_VALIDATE_AUDIENCE=true
JWT_CLOCK_TOLERANCE_SECONDS=30

# Key Rotation (days for RSA, hours for HS256)
JWT_KEY_ROTATION_DAYS=90

# Performance & Caching
JWT_ENABLE_AUDIT_LOG=true
JWT_LOG_SENSITIVE_DATA=false
JWT_BLACKLIST_CLEANUP_INTERVAL=3600
JWT_JWK_CACHE_SIZE=100
JWT_BLACKLIST_CACHE_SIZE=10000

# =============================================================================
# PASSWORD SECURITY
# =============================================================================
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
PASSWORD_MAX_POSTPONES=3

# =============================================================================
# EMAIL & COMMUNICATIONS
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# FILE UPLOAD & SECURITY
# =============================================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ENCRYPTION_KEY=775146c617280f40f5c0f212b640fd4b26c3ab489997958212c3ed9ecb5d8a31
ENCRYPTION_IV=6b5910ba03c6e8d1fc2d034b785213af

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
SESSION_SECRET=9b1445acbee5094831ecb4a3466ff43050718725d1ba64ddccb5f153c0032ee5
SESSION_COOKIE_NAME=sessionId
SESSION_COOKIE_MAX_AGE=86400000
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Redis Session Store (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_SESSION_TTL=86400

# =============================================================================
# CORS & RATE LIMITING
# =============================================================================
CORS_ORIGINS=http://localhost:5174
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Google Gemini AI
# =============================================================================
GOOGLE_API_KEY=AIzaSyAgGRQrPJfyIv5bfDqEIju9ij50IVyVwCE

# =============================================================================
# OAUTH INTEGRATIONS (Optional)
# =============================================================================
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5600/auth/google/callback

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_DIR=./logs

ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER=google_analytics
ANALYTICS_TRACKING_ID=UA-XXXXXXXXX-X

MONITORING_ENABLED=true
MONITORING_INTERVAL_MS=60000

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=7
BACKUP_DIRECTORY=./backups

# =============================================================================
# PRODUCTION SECURITY CHECKLIST
# =============================================================================
# [ ] Change JWT_SECRET to a cryptographically secure value
# [ ] Consider switching to RS256 for production
# [ ] Update CORS_ORIGINS for production domains
# [ ] Enable HTTPS configuration
# [ ] Set SESSION_SECURE=true when using HTTPS
# [ ] Configure proper log rotation
# [ ] Set up monitoring alerts
# [ ] Test key rotation procedures
# [ ] Enable JWT_ENABLE_BLACKLIST for production

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# - Use JWT_ALGORITHM=HS256 for development
# - Use JWT_ALGORITHM=RS256 for production
# - Run 'npm run jwt:generate-key' for HS256 secrets
# - Run 'npm run jwt:generate-rsa' for RSA key pairs
# - Run 'npm run jwt:validate' to check configuration
# - See JWT_SECURITY_GUIDE.md for detailed instructions
