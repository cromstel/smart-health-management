{
  "name": "smart-health-manager-server",
  "version": "1.0.0",
  "description": "Backend API for Smart MediCare",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build && npm run test -- --run",
    "db:setup": "tsx src/database/run-sql.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:status": "tsx src/database/migrate.ts --status"
  },
  "keywords": [
    "healthcare",
    "hospital",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^14.0.1",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "check-disk-space": "^3.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ical-generator": "^11.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "rrule": "^2.8.1",
    "stripe": "^22.6.2",
    "twilio": "^6.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "minimatch": "^11.0.4",
    "mysql2": "^3.24.4",
    "body-parser": "^2.4.0",
    "qs": "^6.17.1",
    "follow-redirects": "^1.16.2",
    "vite": "^8.3.5",
    "ip-address": "^10.7.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
