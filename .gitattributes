# Normalize line endings: repository stores LF for all text.
# This kills the per-commit "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Windows shell scripts keep CRLF on checkout
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.tsbuildinfo binary