				}</style> <script id="google_gtagjs" type="text/javascript" data-src="https://www.googletagmanager.com/gtag/js?id=G-ZQE6R3697Y"></script> <script id="google_gtagjs-inline" type="text/javascript">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ZQE6R3697Y',{})</script> <link rel="icon" href="https://cromstelit.com/storage/2024/03/logo-CIT-Favicon-100x100.webp" sizes="32x32" /><link rel="icon" href="https://cromstelit.com/storage/2024/03/logo-CIT-Favicon-300x300.webp" sizes="192x192" /><link rel="apple-touch-icon" href="https://cromstelit.com/storage/2024/03/logo-CIT-Favicon-300x300.webp" /><meta name="msapplication-TileImage" content="https://cromstelit.com/storage/2024/03/logo-CIT-Favicon-300x300.webp" /><style id="jeg_dynamic_css" type="text/css" data-type="jeg_custom-css"></style><style id="wp-custom-css">/* CSS for New badge on archive page */
.ct-woo-card-extra.new-badge{
	position: absolute;
  background: #0080FF;
	color: #fff;
	font-weight: 500;
	text-transform: uppercase;
	border-radius: 50px;
	font-size: 12px;
	padding: 10px;
	right: 15px;
	z-index: 2;
	display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
	top: 110px;
}
/* CSS for New badge on single product page */
.itsnew {
   background: #f37b21;
   padding: 5px 10px;
   font-size: 12px;
   font-weight: 600;
   color: #fff;
   margin-top: 15px;
   float: right;
   top: 15px;
}

/* CSS for Sales Badge */
.onsale.perc:after {
	border: 5px solid #ff0051;
	border-color: transparent transparent #ff0051 #ff0051;
	border-width: 9px 6px;
	position: absolute;
	right: -10px;
	bottom: 0;
	content: '';
}
.onsale.perc:before {
border: 5px solid #ff0051;
    border-color: #ff0051 transparent transparent #ff0051;
    border-width: 9px 6px;
    position: absolute;
    right: -10px;
    top: -0;
    content: '';
}
.onsale.perc {
	top: 16px;
	left: 0px;
}

/* Custom CSS for featured product badge on archive page */
.featured-badge  {
	top: 20px;
	left: 0px;
	width: 100%;
	background: #1e1e1e99;
	color: #fff;
 display: flex;
  justify-content: center;
	position: absolute;
	z-index: 0;
	font-size: 13px;
	text-transform: uppercase;
	font-weight: 600;
}
/* Woocommerce featured product badge on single product page */
.featured1 {
	background: #fff000;
	color: #000;
	font-weight: 600;
	text-transform: uppercase;
	padding: 5px 10px;
  font-size: 12px;
	font-weight: 600;
	margin-top: 15px;
	float: right;
}

/* Display custom product badge with checking a checkbox */
.custom-badge-1 {
  font-size: 13px;
	text-transform: uppercase;
	color: #fff;
	font-weight: 600;
	background: #ff0051;
	border: 2px solid #ff0051;
	text-align: center;
	padding: 8px;
	display: inline;
}
.entry-summary .price {
	margin-top: 1em;
}

/* Custom CSS for product badge with custom text on single product page */
.custom-badge {
  font-size: 13px;
	text-transform: uppercase;
	color: #1e1e1e;
	font-weight: 600;
	border: 2px dashed #ddd;
	background: #f9f9f9;
	padding: 8px;
	display: inline;
	margin-left: 10px;
}
.entry-summary .price {
	margin-top: 1em;
}

/* CSS to Style the Best Seller Badge */
.best-seller-badge {
    position: absolute;
    top: 50px;
    left: 0px;
    background-color: #f39c12; /* Gold background */
    color: #fff; /* White text */
    padding: 6px 6px;
    font-size: 13px;
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 0px;
    z-index: 10;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.product {
    position: relative; /* Ensure relative positioning for the badge */
}

/* ======================== */
/* CSS for Stock Progress bar */
.wpsh-stock-bar {
			text-align: left;
			display: block;
			margin-bottom: 10px;
			margin-top: 10px;
		}

/* Customize the progress bar's filled portion for WebKit browsers (Chrome, Safari, Edge) */
		.wpsh-stock-bar progress::-webkit-progress-value {
			background-color: #ffcc00; /* Yellow for the filled part */
		}

/* Customize the background color for WebKit browsers */
		.wpsh-stock-bar progress::-webkit-progress-bar {
			background-color: #ccc; /* Light grey for the unfilled part */
		}

		/* Customize the progress bar's filled portion for Firefox */
		.wpsh-stock-bar progress::-moz-progress-bar {
			background-color: #ffcc00; /* Yellow for the filled part */
		}

		/* For browsers that don't support progress bar styling, apply default background */
		.wpsh-stock-bar progress {
			background-color: #ccc;
			border: none;
			width: 100%;
			max-width: 300px;
			height: 20px;
			overflow: hidden;
		}

/* Sale countdown CSS*/
.custom-sale-countdown {
text-align: left;
margin-bottom: 20px;
font-weight: bold;
color: #333;
}
.custom-sale-countdown h3 {
font-size: 18px;
margin-bottom: 10px;
}
.custom-sale-countdown .countdown {
display: flex;
justify-content: flex-start;
gap: 10px;
font-size: 32px;
letter-spacing: 2px;
}.custom-sale-countdown .countdown span {
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
padding: 5px 10px;
background-color: #f8f9fa;
border-radius: 5px;
color: #000;
font-size: 24px;
border: none; /* Remove the border */
}
.custom-sale-countdown .countdown span .countdown-label {
font-size: 12px; /* Smaller label size */
font-weight: normal;
text-transform: uppercase;
color: #666;
margin-top: -15px;
}

/* WooCommerce Product Filters Widgets CSS */
/* Desktop & Tablet (Width 768px and Above) */
@media only screen and (min-width: 768px) {
    .product-filter-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        justify-content: flex-start;
        align-items: center;
        margin-bottom: 20px;
        margin-top: 20px; /* Add top spacing */
    }

    .product-category-dropdown {
        flex: 1;
        max-width: 24%;
    }
}

/* Mobile (Width Below 768px) */
@media only screen and (max-width: 767px) {
    .product-filter-container {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: stretch;
        margin-bottom: 10px;
        margin-top: 10px; /* Add top spacing */
    }

    .product-category-dropdown {
