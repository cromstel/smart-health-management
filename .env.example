# Smart MediCare — environment template
#
# Copy to `.env.local` for local development, or to `.env` for a deployment.
# Never commit a filled-in copy of this file.
#
# Conventions used throughout:
#   * A value that the application reads is listed exactly once, under the
#     section that owns it.
#   * A secret or an optional integration that is not switched on carries a
#     `REPLACE_WITH_…` placeholder. The application treats a placeholder as
#     "not configured", so an integration stays off rather than failing at the
#     moment it is first used.
#   * A value with a sensible default is shown with that default, so the
#     platform runs out of the box.
#   * `APP_NAME` and `VITE_APP_NAME` must hold the same value: the first is
#     read by the API, the second by the browser.

########################################
# Application identity
########################################
# production | development | test
NODE_ENV=development

# The product name. The API reads this; the browser reads VITE_APP_NAME.
APP_NAME="SMART MEDICARE"
# The same name, for the browser bundle. Build-time.
VITE_APP_NAME="SMART MEDICARE"
# Reported by the administration console.
APP_VERSION=1.0.0
# Where the application is served. A comma-separated list is allowed; the
# first entry is the canonical origin. Also the allow-list for CORS.
FRONTEND_URL=http://localhost:5175

########################################
# Ports and hosts
########################################
# The API. Required in production: the platform refuses to start without it.
PORT=5000
# The HTTPS listener. Required in production, for the same reason.
HTTPS_PORT=8443
# The browser development server.
VITE_PORT=5175
# The host the development server answers to.
VITE_HOST=0.0.0.0
# Comma-separated hosts allowed to reach the development server. Unset means
# any host in development.
VITE_ALLOWED_HOSTS=
# The preview server used by the end-to-end suite.
VITE_PREVIEW_PORT=3001
# Where the end-to-end suite finds the API. Unset means the origin of
# VITE_API_URL, and then the local API.
E2E_API_ORIGIN=
# The certificate and key for the HTTPS listener. Unset means
# server/certs/cert.pem and server/certs/key.pem.
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=

########################################
# Browser client
########################################
# Where the browser calls the API. Unset means the same origin, at /api.
VITE_API_URL=http://localhost:5000/api
# Set to true to always use the same-origin /api path in development, for
# example when the development server proxies /api to the API server.
VITE_DEV_API_PROXY_ONLY=false
# Set to false to switch the product analytics off.
VITE_ANALYTICS_ENABLED=true

########################################
# Database
########################################
# The application database. The password has no default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_medicare
DB_USER=root
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Set to true only when the server requires TLS.
DB_SSL=false

# The optional Ghana Health Service data source. Left empty it is off.
GHS_DB_HOST=
GHS_DB_PORT=3306
GHS_DB_NAME=
GHS_DB_USER=
GHS_DB_PASSWORD=

########################################
# Authentication, sessions and encryption
########################################
# Required in production.
JWT_SECRET=REPLACE_WITH_JWT_SECRET
JWT_EXPIRES_IN=24h
SESSION_SECRET=REPLACE_WITH_SESSION_SECRET
# 32-byte key and 16-byte IV, hex encoded. Required in production.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
ENCRYPTION_IV=REPLACE_WITH_32_HEX_CHAR_KEY
# The bcrypt cost for new passwords.
BCRYPT_ROUNDS=12
# How many times a password may be deferred before it must be changed.
PASSWORD_MAX_POSTPONES=3
# Failed sign-ins before the account is locked.
MAX_LOGIN_ATTEMPTS=5
# How long an account stays locked, in milliseconds.
LOCKOUT_DURATION=900000
# Request ceilings.
LOGIN_RATE_LIMIT_MAX=5
TWO_FACTOR_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=10
# How long a recovery link is valid, in minutes.
PASSWORD_RESET_TTL_MINUTES=30
# The session cookie.
SESSION_COOKIE_NAME=shms_session
SESSION_COOKIE_MAX_AGE=28800000
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE=false
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=true
# The passkey relying party.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5175
WEBAUTHN_RP_NAME="SMART MEDICARE"

########################################
# Email
########################################
# The display name on outgoing mail. Falls back to APP_NAME.
MAIL_FROM_NAME="SMART MEDICARE"
EMAIL_FROM=no-reply@example.com
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
# SMTP_USER and SMTP_PASS are accepted as aliases.
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_REPLY_TO=
# Where a request-a-demo submission is delivered.
DEMO_REQUEST_RECIPIENT=
# Who receives the inventory and batch notifications.
ADMIN_EMAIL=
ADMIN_PHONE=

########################################
# Storage and backups
########################################
# Where uploaded documents are written. Relative to the working directory.
UPLOAD_DIR=server/uploads
# The largest upload accepted, in bytes.
MAX_FILE_SIZE=10485760
# The per-tenant document quota, in bytes.
LOCAL_STORAGE_QUOTA_BYTES=5242880
# Where database backups are written.
BACKUP_DIR=server/backups
# The daily backup schedule, in cron syntax.
BACKUP_CRON=0 2 * * *
# How long a backup is kept, in days.
BACKUP_RETENTION_DAYS=30
# The dump tool. The platform's own copy is found by default.
MYSQLDUMP_BIN=mysqldump

########################################
# Clinical AI
########################################
# The model provider. A placeholder leaves the assistant answering from the
# recorded observations instead.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
# Whether patient observations may be sent to the external model. Off by
# default: an outbound call to a third party is a disclosure decision.
GEMINI_SEND_PHI=false
GEMINI_TIMEOUT_MS=120000
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_RATE_LIMIT_MAX=20
# How long a shared patient summary link lives, in hours.
SHARED_SUMMARY_TTL_HOURS=24

########################################
# Payments and messaging
########################################
# Card payments. A placeholder leaves the feature off.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_CURRENCY=usd
# WhatsApp and SMS.
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER

########################################
# Document storage providers
########################################
# Google Drive. A placeholder leaves the provider off and the local
# filesystem provider in use.
GOOGLE_DRIVE_CLIENT_ID=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/storage/google/callback
# OneDrive. A placeholder leaves the provider off.
ONEDRIVE_CLIENT_ID=REPLACE_WITH_ONEDRIVE_CLIENT_ID
ONEDRIVE_CLIENT_SECRET=REPLACE_WITH_ONEDRIVE_CLIENT_SECRET
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/storage/onedrive/callback

########################################
# Seeded demo accounts
########################################
# The local seed creates the demo accounts with these passwords, hashing them
# at seed time. No password and no hash is stored in the repository.
SEED_SUPER_ADMIN_PASSWORD=REPLACE_WITH_SEED_SUPER_ADMIN_PASSWORD
SEED_ADMIN_PASSWORD=REPLACE_WITH_SEED_ADMIN_PASSWORD
SEED_DOCTOR_PASSWORD=REPLACE_WITH_SEED_DOCTOR_PASSWORD
SEED_PATIENT_PASSWORD=REPLACE_WITH_SEED_PATIENT_PASSWORD
# The bcrypt cost the seed uses.
SEED_BCRYPT_ROUNDS=10
# The platform accounts. SUPER_ADMIN_PASSWORD and ADMIN_PASSWORD are the
# accepted aliases of the two SEED_ variables above.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SUPER_ADMIN_PASSWORD
# The seeded accounts' addresses are defined by the seed. The administrator
# address used for notifications is ADMIN_EMAIL, in the email section above.
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
