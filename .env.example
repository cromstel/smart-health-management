# Smart Health Management System — environment template
#
# Copy this file to .env.local for local development. Never commit .env.local
# or replace the placeholders below with real credentials in this file.

########################################
# Application and browser client
########################################
NODE_ENV=development
PORT=5000
HTTPS_PORT=8443
FRONTEND_URL=http://localhost:3000
VITE_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
# Legacy client setting; leave aligned with VITE_API_URL when used.
VITE_API_BASE_URL=http://localhost:5000/api

########################################
# WebAuthn passkeys (RP identity)
########################################
# RP ID is the effective domain WITHOUT scheme — "localhost" in dev.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Smart Health Management System

########################################
# Database (MySQL)
########################################
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_health_manager
DB_USER=smart_health_user
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Set true only when the MySQL server requires TLS.
DB_SSL=false

########################################
# Authentication, sessions, and encryption
########################################
# Generate unique cryptographically random values for every production environment.
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_SECRET
JWT_EXPIRES_IN=24h
SESSION_SECRET=REPLACE_WITH_64_BYTE_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
ENCRYPTION_IV=REPLACE_WITH_32_HEX_CHAR_IV
BCRYPT_ROUNDS=12
PASSWORD_MAX_POSTPONES=3
LOCKOUT_DURATION=900000
MAX_LOGIN_ATTEMPTS=5
SESSION_COOKIE_NAME=shms_session
SESSION_COOKIE_MAX_AGE=28800000
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE=false
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false

########################################
# Email and public demo requests
########################################
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# Backward-compatible aliases accepted by the mail utility. Set only if your provider uses them.
SMTP_USER=
SMTP_PASS=
# Requests submitted at /request-demo are delivered only to this recipient.
DEMO_REQUEST_RECIPIENT=sales@example.com
# Optional recipients for inventory/batch notifications.
ADMIN_EMAIL=operations@example.com
ADMIN_PHONE=+15555550100

########################################
# Third-party integrations (optional unless enabled)
########################################
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
GOOGLE_API_URL=
GOOGLE_DRIVE_CLIENT_ID=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/storage/google/callback
ONEDRIVE_CLIENT_ID=REPLACE_WITH_ONEDRIVE_CLIENT_ID
ONEDRIVE_CLIENT_SECRET=REPLACE_WITH_ONEDRIVE_CLIENT_SECRET
ONEDRIVE_REDIRECT_URI=http://localhost:5000/api/storage/onedrive/callback
OAUTH_GOOGLE_CLIENT_ID=REPLACE_WITH_OAUTH_GOOGLE_CLIENT_ID
OAUTH_GOOGLE_CLIENT_SECRET=REPLACE_WITH_OAUTH_GOOGLE_CLIENT_SECRET
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
OAUTH_FACEBOOK_CLIENT_ID=REPLACE_WITH_OAUTH_FACEBOOK_CLIENT_ID
OAUTH_FACEBOOK_CLIENT_SECRET=REPLACE_WITH_OAUTH_FACEBOOK_CLIENT_SECRET
OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:5000/api/auth/facebook/callback
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_CURRENCY=USD
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+15555550101

########################################
# Ghana Health Service data integration (optional)
########################################
GHS_DB_HOST=
GHS_DB_PORT=3306
GHS_DB_NAME=
GHS_DB_USER=
GHS_DB_PASSWORD=

########################################
# Storage, backups, monitoring, and analytics
########################################
UPLOAD_DIR=server/uploads
MAX_FILE_SIZE=10485760
LOCAL_STORAGE_QUOTA_BYTES=5242880
BACKUP_DIRECTORY=server/backups
BACKUP_CRON=0 2 * * *
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=
ANALYTICS_TRACKING_ID=
MONITORING_ENABLED=false
MONITORING_INTERVAL_MS=60000
LOG_DIR=logs
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

########################################
# Infrastructure and optional feature switches
########################################
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=86400
NAME=Smart Health Management System
FEATURE_W_ENABLED=false
FEATURE_X_ENABLED=false
FEATURE_Y_ENABLED=false
FEATURE_Z_ENABLED=false
